// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// IAM System Models

model Users {
  id            Int                     @id @default(autoincrement())
  username      String                  @unique
  email         String                  @unique
  password_hash String
  created_at    DateTime                @default(now())
  
  // Relationships
  auditLogs     AuditLogs[]
  reports       Reports[]               @relation("ReporterReports")
  approvals     Approvals[]             @relation("ApproverApprovals")
  entityMembers EntityMembers[]
}

model Permissions {
  id            Int                    @id @default(autoincrement())
  name          String                 @unique
  description   String?
  action        String                 // view, create, update, delete
  created_at    DateTime               @default(now())
  
  // Relationships
  entityRolePermissions EntityRolePermissions[]
}

model Resources {
  id            Int                    @id @default(autoincrement())
  name          String                 @unique
  path          String                 @unique
  description   String?
  created_at    DateTime               @default(now())
  
  // Relationships
  entityRolePermissions EntityRolePermissions[]
}

// Entity Types (e.g., Club, Venue, Department)
model EntityTypes {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String?
  created_at  DateTime      @default(now())
  
  // Relations
  entities    Entities[]
  entityRoles EntityRoles[]
}

// Entities (e.g., Chess Club, Main Hall, IT Department)
model Entities {
  id             Int            @id @default(autoincrement())
  name           String
  description    String?
  created_at     DateTime       @default(now())
  entity_type_id Int
  
  // Relations
  entityType     EntityTypes    @relation(fields: [entity_type_id], references: [id])
  entityMembers  EntityMembers[]
  entityRoles    EntityRoles[]  // Each entity can define its own roles
}

// Entity Roles (e.g., Owner, Admin, Member for a specific entity)
model EntityRoles {
  id                   Int                    @id @default(autoincrement())
  name                 String
  description          String?
  created_at           DateTime               @default(now())
  entity_type_id       Int                    // Keep entity_type_id temporarily
  entity_id            Int?                   // Add entity_id as optional initially
  is_default          Boolean                 @default(false)  // Indicates if this is a default role for the entity
  
  // Relations
  entityType           EntityTypes            @relation(fields: [entity_type_id], references: [id])
  entity               Entities?              @relation(fields: [entity_id], references: [id])
  entityMembers        EntityMembers[]
  entityRolePermissions EntityRolePermissions[]
  
  // Composite unique constraints
  @@unique([name, entity_type_id])
  @@unique([name, entity_id])
}

// Entity Members (Users assigned to entities with specific roles)
model EntityMembers {
  id             Int         @id @default(autoincrement())
  entity_id      Int
  user_id        Int
  entity_role_id Int
  created_at     DateTime    @default(now())
  
  // Relations
  entity         Entities    @relation(fields: [entity_id], references: [id])
  user           Users       @relation(fields: [user_id], references: [id])
  entityRole     EntityRoles @relation(fields: [entity_role_id], references: [id])
  
  // Composite unique constraint
  @@unique([entity_id, user_id])
}

// Permissions for entity roles
model EntityRolePermissions {
  id              Int           @id @default(autoincrement())
  entity_role_id  Int
  permission_id   Int
  resource_id     Int
  created_at      DateTime      @default(now())
  
  // Relationships
  entityRole      EntityRoles   @relation(fields: [entity_role_id], references: [id], onDelete: Cascade)
  permission      Permissions   @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  resource        Resources     @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  
  // Unique constraint to prevent duplicates
  @@unique([entity_role_id, permission_id, resource_id])
}

model Reports {
  id          Int           @id @default(autoincrement())
  reporter_id Int
  report_type String
  content     String
  status      String
  created_at  DateTime      @default(now())
  reporter    Users         @relation("ReporterReports", fields: [reporter_id], references: [id])
  approvals   Approvals[]
}

model Approvals {
  id          Int      @id @default(autoincrement())
  approver_id Int
  entity_type String
  entity_id   Int
  action      String
  remarks     String?
  created_at  DateTime @default(now())
  approver    Users    @relation("ApproverApprovals", fields: [approver_id], references: [id])
  report      Reports? @relation(fields: [entity_id], references: [id])
}

model AuditLogs {
  id          Int      @id @default(autoincrement())
  user_id     Int
  entity_type String
  entity_id   Int
  action      String
  timestamp   DateTime @default(now())
  user        Users    @relation(fields: [user_id], references: [id])
}
