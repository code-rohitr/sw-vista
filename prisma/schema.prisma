generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  email         String    @unique
  password_hash String
  role          String
  created_at    DateTime  @default(now())
  
  // Relations
  venue_bookings    VenueBooking[]
  event_feedback    EventFeedback[]
  proposals         Proposal[]      @relation("ProposerToProposal")
  reports          Report[]        @relation("ReporterToReport")
  approvals        Approval[]      @relation("ApproverToApproval")
  notifications    CalendarNotification[]
  audit_logs       AuditLog[]
  club_memberships ClubMember[]

  @@map("users")
}

model UserRole {
  id          Int      @id @default(autoincrement())
  role_name   String   @unique
  permissions String
  
  @@map("user_roles")
}

model Venue {
  id          Int      @id @default(autoincrement())
  name        String
  location    String
  capacity    Int
  description String?
  image_url   String?
  
  // Relations
  bookings    VenueBooking[]
  catalogue   VenueCatalogue[]

  @@map("venues")
}

model VenueBooking {
  id          Int      @id @default(autoincrement())
  event_name  String
  event_date  DateTime
  start_time  DateTime
  end_time    DateTime
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
  status      Int      @default(1) // 0: Rejected, 1: Submitted, 2: FA Approved, 3: SC Approved, 4: SWO Approved, 5: Security Approved
  user        User     @relation(fields: [user_id], references: [id])
  user_id     Int
  venue       Venue    @relation(fields: [venue_id], references: [id])
  venue_id    Int
  proposal    Proposal? @relation(fields: [proposal_id], references: [id])
  proposal_id Int?

  // Relations
  reports Report[]
  event_history EventHistory[]

  @@map("venue_bookings")
}

model EventFeedback {
  id         Int      @id @default(autoincrement())
  event_id   Int
  user_id    Int
  rating     Int
  comments   String?
  created_at DateTime @default(now())
  
  // Relations
  user       User     @relation(fields: [user_id], references: [id])

  @@map("event_feedback")
}

model Proposal {
  id             Int      @id @default(autoincrement())
  proposer_id    Int
  title          String
  description    String?
  event_type     String
  requested_date DateTime
  status         String
  created_at     DateTime @default(now())
  
  // Relations
  proposer       User     @relation("ProposerToProposal", fields: [proposer_id], references: [id])
  venue_bookings VenueBooking[]

  @@map("proposals")
}

model Report {
  id          Int      @id @default(autoincrement())
  reporter_id Int
  report_type String
  content     String
  event_id    Int
  status      String
  created_at  DateTime @default(now())
  
  // Relations
  reporter    User         @relation("ReporterToReport", fields: [reporter_id], references: [id])
  event       VenueBooking @relation(fields: [event_id], references: [id])

  @@map("reports")
}

model Club {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  description String?
  created_at  DateTime    @default(now())
  
  // Relations
  members     ClubMember[]

  @@map("clubs")
}

model ClubMember {
  id        Int      @id @default(autoincrement())
  club_id   Int
  user_id   Int
  role      String
  joined_at DateTime @default(now())
  
  // Relations
  club      Club     @relation(fields: [club_id], references: [id])
  user      User     @relation(fields: [user_id], references: [id])

  @@map("club_members")
}

model CalendarNotification {
  id               Int      @id @default(autoincrement())
  user_id         Int
  event_id        Int
  notification_type String
  sent_at         DateTime @default(now())
  
  // Relations
  user            User     @relation(fields: [user_id], references: [id])

  @@map("calendar_notifications")
}

model VenueCatalogue {
  id               Int      @id @default(autoincrement())
  venue_id         Int
  image_url        String
  additional_details String?
  
  // Relations
  venue           Venue    @relation(fields: [venue_id], references: [id])

  @@map("venue_catalogue")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  user_id    Int
  entity_type String
  entity_id   Int
  action      String
  timestamp   DateTime @default(now())
  
  // Relations
  user       User     @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}

model EventHistory {
  id               Int      @id @default(autoincrement())
  venue_booking_id Int
  event_status     String
  feedback         String?
  created_at       DateTime @default(now())
  
  // Relations
  venue_booking    VenueBooking @relation(fields: [venue_booking_id], references: [id])

  @@map("event_history")
}

model Approval {
  id          Int      @id @default(autoincrement())
  approver_id Int
  entity_type String
  entity_id   Int
  action      String
  remarks     String?
  created_at  DateTime @default(now())
  
  // Relations
  approver    User     @relation("ApproverToApproval", fields: [approver_id], references: [id])

  @@map("approvals")
}
