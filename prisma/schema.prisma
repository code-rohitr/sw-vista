// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core Models
model users {
  id                Int              @id @default(autoincrement())
  username          String           @unique
  email             String           @unique
  password_hash     String
  created_at        DateTime         @default(now())
  
  // Relationships
  entityMembers     entityMembers[]
  auditLogs         auditLog[]
  reports           report[]         @relation("ReporterReports")
  approvals         approval[]       @relation("ApproverApprovals")
  createdBookings   VenueBooking[]   @relation("BookingCreator")
  approvedBookings  VenueBooking[]   @relation("BookingApprover")
}

model permissions {
  id            Int                     @id @default(autoincrement())
  name          String                  @unique
  description   String?
  action        String                  // view, create, update, delete
  created_at    DateTime                @default(now())
  
  // Relationships
  entityRolePermissions entityRolePermissions[]
  permissionResources   permissionResources[]
}

model resources {
  id            Int                     @id @default(autoincrement())
  name          String                  @unique
  path          String                  @unique
  description   String?
  created_at    DateTime                @default(now())
  
  // Relationships
  permissionResources   permissionResources[]
  entityRolePermissions entityRolePermissions[]
}

// Junction Tables
model permissionResources {
  id            Int         @id @default(autoincrement())
  permission_id Int
  resource_id   Int
  created_at    DateTime    @default(now())
  
  // Relationships
  permission    permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  resource      resources   @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  
  @@unique([permission_id, resource_id])
}

model entityRolePermissions {
  id              Int           @id @default(autoincrement())
  entity_role_id  Int
  permission_id   Int
  resource_id     Int          // Keep this for now
  created_at      DateTime      @default(now())
  
  // Relationships
  entityRole      entityRoles   @relation(fields: [entity_role_id], references: [id], onDelete: Cascade)
  permission      permissions   @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  resource        resources     @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  
  @@unique([entity_role_id, permission_id, resource_id])
}

// Entity Models
model entityTypes {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  description String?
  created_at  DateTime      @default(now())
  
  // Relationships
  entities    entity[]
  entityRoles entityRoles[]
}

model entity {
  id             Int            @id @default(autoincrement())
  name           String
  description    String?
  created_at     DateTime       @default(now())
  entity_type_id Int
  
  // Relationships
  entityType     entityTypes    @relation(fields: [entity_type_id], references: [id])
  entityMembers  entityMembers[]
  entityRoles    entityRoles[]
  venues         Venue[]
  venueBookings  VenueBooking[]
}

model entityRoles {
  id             Int                     @id @default(autoincrement())
  name           String
  description    String?
  created_at     DateTime                @default(now())
  entity_type_id Int
  entity_id      Int?
  is_default     Boolean                 @default(false)
  
  // Relationships
  entityType     entityTypes             @relation(fields: [entity_type_id], references: [id])
  entity         entity?                 @relation(fields: [entity_id], references: [id])
  entityMembers  entityMembers[]
  entityRolePermissions entityRolePermissions[]
  
  @@unique([name, entity_type_id])
  @@unique([name, entity_id])
}

model entityMembers {
  id             Int         @id @default(autoincrement())
  entity_id      Int
  user_id        Int
  entity_role_id Int
  created_at     DateTime    @default(now())
  
  // Relationships
  entity         entity      @relation(fields: [entity_id], references: [id])
  user           users       @relation(fields: [user_id], references: [id])
  entityRole     entityRoles @relation(fields: [entity_role_id], references: [id])
  
  @@unique([entity_id, user_id])
}

// Audit and Reporting Models
model report {
  id          Int        @id @default(autoincrement())
  reporter_id Int
  report_type String
  content     String
  status      String
  created_at  DateTime   @default(now())
  
  // Relationships
  reporter    users      @relation("ReporterReports", fields: [reporter_id], references: [id])
  approvals   approval[]
}

model approval {
  id          Int       @id @default(autoincrement())
  approver_id Int
  entity_type String
  entity_id   Int
  action      String
  remarks     String?
  created_at  DateTime  @default(now())
  
  // Relationships
  approver    users     @relation("ApproverApprovals", fields: [approver_id], references: [id])
  report      report?   @relation(fields: [entity_id], references: [id])
}

model auditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int
  entity_type String
  entity_id   Int
  action      String
  timestamp   DateTime @default(now())
  
  // Relationships
  user        users    @relation(fields: [user_id], references: [id])
}

// Venue Models
model Venue {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  address     String?
  capacity    Int?
  amenities   String?
  entity_id   Int
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt
  
  // Relationships
  entity      entity         @relation(fields: [entity_id], references: [id])
  bookings    VenueBooking[]

  @@map("venues")
}

model VenueBooking {
  id              Int       @id @default(autoincrement())
  venue_id        Int
  entity_id       Int       // Entity that booked the venue
  title           String
  description     String?
  start_time      DateTime
  end_time        DateTime
  status          String    // pending, approved, rejected, cancelled
  created_by      Int       // User ID who created the booking
  approved_by     Int?      // User ID who approved the booking
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  
  // Relationships
  venue           Venue     @relation(fields: [venue_id], references: [id])
  entity          entity    @relation(fields: [entity_id], references: [id])
  creator         users     @relation("BookingCreator", fields: [created_by], references: [id])
  approver        users?    @relation("BookingApprover", fields: [approved_by], references: [id])

  @@map("venue_bookings")
}
